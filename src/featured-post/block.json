{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gutenberg-taxonomy-cards/featured-post",
  "title": "Featured Post",
  "category": "widgets",
  "description": "Showcases one specific post as a large callout card — featured image, title, excerpt, author, date.",
  "keywords": [ "post", "featured", "callout", "hero", "highlight" ],
  "version": "1.0.0",
  "textdomain": "gutenberg-taxonomy-cards",
  "attributes": {
    "postType": { "type": "string", "default": "" },
    "postTypeRestBase": { "type": "string", "default": "" },
    "post": { "type": "number", "default": 0 },
    "layout": { "type": "string", "default": "stacked" },
    "showImage": { "type": "boolean", "default": true },
    "showExcerpt": { "type": "boolean", "default": true },
    "showAuthor": { "type": "boolean", "default": true },
    "showDate": { "type": "boolean", "default": true },
    "showCta": { "type": "boolean", "default": false },
    "cardRadius": { "type": "number", "default": 16 },
    "imageRatio": { "type": "string", "default": "4/3" },
    "imageFit": { "type": "string", "default": "cover" },
    "hoverAnimation": { "type": "string", "default": "lift" },
    "borderWidth": { "type": "number", "default": 0 },
    "borderStyle": { "type": "string", "default": "solid" },
    "borderColor": { "type": "string", "default": "" },
    "cardBackgroundColor": { "type": "string", "default": "" },
    "titleFontSize": { "type": "number", "default": 0 },
    "titleColor": { "type": "string", "default": "" },
    "excerptFontSize": { "type": "number", "default": 0 },
    "excerptColor": { "type": "string", "default": "" },
    "metaFontSize": { "type": "number", "default": 0 },
    "metaColor": { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "align": [ "wide", "full" ],
    "color": {
      "background": true,
      "text": true,
      "gradients": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
