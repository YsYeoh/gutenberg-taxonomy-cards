{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gutenberg-taxonomy-cards/taxonomy-category-cards",
  "title": "Taxonomy Category Cards",
  "category": "widgets",
  "description": "Displays terms from any taxonomy as responsive cards. Choose a post type and taxonomy in the block settings.",
  "keywords": [ "taxonomy", "category", "cards", "post type", "terms" ],
  "version": "1.0.0",
  "textdomain": "gutenberg-taxonomy-cards",
  "attributes": {
    "postType": { "type": "string", "default": "" },
    "taxonomy": { "type": "string", "default": "" },
    "taxonomyRestBase": { "type": "string", "default": "" },
    "taxonomyLabel": { "type": "string", "default": "" },
    "columns": { "type": "number", "default": 4 },
    "gap": { "type": "number", "default": 24 },
    "showImage": { "type": "boolean", "default": true },
    "showDescription": { "type": "boolean", "default": true },
    "showCount": { "type": "boolean", "default": true },
    "showCta": { "type": "boolean", "default": false },
    "hideEmpty": { "type": "boolean", "default": false },
    "orderBy": { "type": "string", "default": "name" },
    "order": { "type": "string", "default": "asc" },
    "cardRadius": { "type": "number", "default": 16 },
    "imageRatio": { "type": "string", "default": "4/3" },
    "imageFit": { "type": "string", "default": "cover" },
    "titleFontSize": { "type": "number", "default": 0 },
    "titleColor": { "type": "string", "default": "" },
    "descriptionFontSize": { "type": "number", "default": 0 },
    "descriptionColor": { "type": "string", "default": "" },
    "countFontSize": { "type": "number", "default": 0 },
    "countColor": { "type": "string", "default": "" },
    "categoryIcons": { "type": "object", "default": {} },
    "borderWidth": { "type": "number", "default": 0 },
    "borderStyle": { "type": "string", "default": "solid" },
    "borderColor": { "type": "string", "default": "" },
    "cardBackgroundColor": { "type": "string", "default": "" },
    "hoverAnimation": { "type": "string", "default": "lift" },
    "iconPosition": { "type": "string", "default": "bottom-left" },
    "categoryBorderColors": { "type": "object", "default": {} },
    "categoryAnimations": { "type": "object", "default": {} }
  },
  "supports": {
    "html": false,
    "align": [ "wide", "full" ],
    "color": {
      "background": true,
      "text": true,
      "gradients": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
